{
  "name": "@deepseek-ai/dsh-tool-fetch-page",
  "description": "Model-facing fetch_page tool that forwards HTTP requests through the local browser-extension relay daemon (cookie-bearing, CORS-free)",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-shell": "^0.1.2-rc.1 || >=0.1.6-alpha.1 <0.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1 || >=0.1.6-alpha.1 <0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-shell": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@types/node": "^24.13.3",
    "schemastery": "^3.18.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
