#!/usr/bin/env node
'use strict';
const http = require('http');
const { execFile } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');

// 镜像加速：Hindsight 本地 daemon 的 uvx/uv 下载 + HuggingFace 模型下载（可被外部环境变量覆盖）
process.env.UV_DEFAULT_INDEX = process.env.UV_DEFAULT_INDEX || 'https://mirrors.aliyun.com/pypi/simple/';
process.env.UV_INDEX_URL = process.env.UV_INDEX_URL || 'https://mirrors.aliyun.com/pypi/simple/';
process.env.HF_ENDPOINT = process.env.HF_ENDPOINT || 'https://hf-mirror.com';

const PORT = Number(process.env.DSH_DAEMON_PORT || 9317);
// npm 包安装模式：dsh 由 `npx -y @deepseek-ai/dsh` 提供（npm latest），
// 不再依赖本地 git checkout。可用环境变量 DSH_NPM_PKG 覆盖包名。
const NPM_PKG = process.env.DSH_NPM_PKG || '@deepseek-ai/dsh';
const DSH_PORT = Number(process.env.DSH_PORT || 3080);
const DSH_LOG = '/tmp/dsh-web-' + DSH_PORT + '.log';
const CTL_LOG = '/tmp/dsh-relay-daemon.log';
const LSOF = '/usr/sbin/lsof';
const NODE = process.execPath;
const NPM = process.env.DSH_NPM_CMD || path.join(path.dirname(NODE), 'npm');
const NPX = process.env.DSH_NPX_CMD || path.join(path.dirname(NODE), 'npx');
// npm registry 镜像（默认淘宝源，可外部覆盖）
const NPM_REGISTRY = process.env.DSH_NPM_REGISTRY || 'https://registry.npmmirror.com';
// DSH 启动命令。默认走 npx（npm latest，带缓存）；可整条覆盖：
//   DSH_START_CMD="node /abs/path/to/dsh/lib/bin.js web --port 3080"
const DSH_START = process.env.DSH_START_CMD
  || (NPX + ' -y ' + NPM_PKG + ' web --port ' + DSH_PORT);
// 预发布版钉住记录（原地安装预发布版时写入；回到 latest 通道后清除）。
// 有 pin 且版本与已安装一致时改用「直启已安装副本」：npx 对裸包名总会回查 registry 解析 latest
// （libnpmexec: npxByNameOnly 分支），会把原地装的预发布版打回去。
const PIN_FILE = process.env.DSH_PIN_FILE || path.join(os.homedir(), '.dsh', 'dsh-relay-daemon-pin.json');

// ---- 版本检查 / 更新（npm registry 模式）----
const NPM_TIMEOUT = 3 * 60 * 1000;
// 版本通道（读 dist-tags）：
//   auto(默认) = 有正式版跟 latest 通道；尚无正式版则取最高版本（可能为预发布）
//   latest | next | alpha | newest | 任意 dist-tag 名 = 固定跟随该通道
const UPDATE_CHANNEL = String(process.env.DSH_UPDATE_CHANNEL || 'auto').toLowerCase();

// ---- 转发状态 ----
let seq = 0;
const pending = [];
const waiters = [];
const results = new Map();

// ---- 更新任务状态 ----
let updating = false;
let updateState = { state: 'idle', startedAt: null, finishedAt: null, step: '', message: '', error: null, warnings: [], detail: [] };

// ---- 服务生命周期状态（启动/停止/重启进度） ----
let lifecycle = {
  state: 'idle',        // idle | starting | running | stopping | restarting | failed
  startedAt: null,
  finishedAt: null,
  step: '',
  message: '',
  error: null,
  log: '',
};

function log(msg) {
  try { fs.appendFileSync(CTL_LOG, new Date().toISOString() + ' ' + msg + '\n'); } catch (e) {}
}

function respond(res, obj, status) {
  const body = JSON.stringify(obj);
  res.writeHead(status || 200, {
    'Content-Type': 'application/json; charset=utf-8',
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET,POST,OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
  });
  res.end(body);
}

function sh(cmd, timeout) {
  return new Promise((resolve) => {
    // launchd 下 PATH 极简(/usr/bin:/bin:/usr/sbin:/sbin),缺少 node/pnpm 所在目录,
    // 会导致 pnpm 的 lifecycle 脚本报 `env: node: No such file or directory`。
    // 这里把 node 可执行文件目录和 /usr/local/bin 前置。
    const nodeBin = path.dirname(NODE);
    const env = Object.assign({}, process.env, {
      PATH: [nodeBin, '/usr/local/bin', process.env.PATH].filter(Boolean).join(':'),
    });
    execFile('/bin/bash', ['-c', cmd], { timeout: timeout || 30000, maxBuffer: 16 * 1024 * 1024, env: env }, (err, stdout, stderr) => {
      resolve({ code: err ? (typeof err.code === 'number' ? err.code : 1) : 0, stdout: String(stdout), stderr: String(stderr) });
    });
  });
}

// shell 单引号转义
function shq(s) {
  return "'" + String(s).replace(/'/g, "'\\''") + "'";
}

function trim(s) {
  return String(s || '').trim();
}

function tail(s, n) {
  const t = trim(s);
  if (!t) return '';
  return t.length > (n || 4000) ? t.slice(-(n || 4000)) : t;
}

function git(args, timeout) {
  // 保留函数签名兼容（不再使用），直接报错提示
  return Promise.resolve({ code: 1, stdout: '', stderr: 'git mode removed: dsh now runs via npx ' + NPM_PKG });
}

function readJson(file) {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch (e) { return null; }
}

// 定位 npx 缓存里安装的 dsh 包目录（最新一个）；无则 null
// npx 缓存根：跟随 npm 的 cache 配置（默认 ~/.npm/_npx）
function npxCacheBase() {
  const cacheRoot = process.env.npm_config_cache || path.join(os.homedir(), '.npm');
  return path.join(cacheRoot, '_npx');
}

function findNpxDshDir() {
  const base = npxCacheBase();
  let best = null;
  let bestMtime = 0;
  try {
    for (const entry of fs.readdirSync(base)) {
      const pkgDir = path.join(base, entry, 'node_modules', NPM_PKG, 'package.json');
      let st;
      try { st = fs.statSync(pkgDir); } catch (e) { continue; }
      if (st.mtimeMs > bestMtime) { bestMtime = st.mtimeMs; best = path.dirname(pkgDir); }
    }
  } catch (e) {}
  return best;
}

// 当前已安装（npx 缓存里）的 dsh 版本
async function getLocalInfo() {
  const dir = findNpxDshDir();
  let version = null;
  if (dir) {
    const pkg = readJson(path.join(dir, 'package.json'));
    version = (pkg && pkg.version) || null;
  }
  return {
    dir: dir || null,
    packageVersion: version,
    installMode: 'npx',
  };
}

// 在既有 _npx 目录内原地安装指定版本：
// 同一目录 → profile 的 @deepseek-ai/* 软链与 host 同源（避免新建第二个 _npx 目录造成 host/插件版本错配）
async function installVersionInPlace(version, npxDirHint) {
  let npxDir = npxDirHint || null;
  if (!npxDir) {
    const pkgDir = findNpxDshDir();
    if (pkgDir) npxDir = path.dirname(path.dirname(pkgDir)); // .../_npx/<hash>
  }
  if (!npxDir || !fs.existsSync(npxDir)) throw new Error('未找到 npx 缓存中的 ' + NPM_PKG + ' 安装目录，无法原地安装');
  const r = await sh(
    'cd ' + shq(npxDir) + ' && npm_config_registry=' + shq(NPM_REGISTRY) + ' ' + NPM +
      ' install ' + NPM_PKG + '@' + version + ' --no-audit --no-fund 2>&1',
    NPM_TIMEOUT
  );
  if (r.code !== 0) throw new Error('原地安装 ' + NPM_PKG + '@' + version + ' 失败：' + tail(r.stdout || r.stderr, 2000));
  return npxDir;
}

// ---- 预发布钉住（pin）----
function readPin() {
  const j = readJson(PIN_FILE);
  return j && typeof j.version === 'string' && j.version ? { version: j.version, at: j.at || null } : null;
}

function writePin(version) {
  try {
    fs.mkdirSync(path.dirname(PIN_FILE), { recursive: true });
    fs.writeFileSync(PIN_FILE, JSON.stringify({ version: version, at: new Date().toISOString() }, null, 1));
    appendDetail('pin: ' + version + ' (' + PIN_FILE + ')');
  } catch (e) {
    updateState.warnings.push('写入 pin 失败（下次启动可能回退到 latest）：' + String((e && e.message) || e));
  }
}

function clearPin() {
  try {
    if (fs.existsSync(PIN_FILE)) { fs.rmSync(PIN_FILE, { force: true }); appendDetail('pin cleared: ' + PIN_FILE); }
  } catch (e) {}
}

// 启动 DSH 的命令：显式 DSH_START_CMD > 有 pin 且与已安装版本一致（直启该副本，避免 npx 回退 latest）> 裸 spec
async function dshStartCommand() {
  if (process.env.DSH_START_CMD) return DSH_START;
  const pin = readPin();
  if (pin) {
    const cur = await getLocalInfo();
    const bin = cur.dir ? path.join(cur.dir, 'lib', 'bin.js') : null;
    if (cur.packageVersion && cur.packageVersion === pin.version && bin && fs.existsSync(bin)) {
      return NODE + ' ' + shq(bin) + ' web --port ' + DSH_PORT;
    }
    clearPin(); // pin 过期（安装已被覆盖或目录缺失）→ 回到裸 spec
  }
  return DSH_START;
}

// ---- 版本比较（semver 子集:x.y.z 与 x.y.z-pre.n 足够本场景）----
function parseVer(v) {
  const m = /^(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?/.exec(String(v || '').trim());
  if (!m) return null;
  return { core: [Number(m[1]), Number(m[2]), Number(m[3])], pre: m[4] ? m[4].split('.') : [] };
}

function cmpVer(a, b) {
  const x = parseVer(a);
  const y = parseVer(b);
  if (!x || !y) return 0;
  for (let i = 0; i < 3; i++) {
    if (x.core[i] !== y.core[i]) return x.core[i] < y.core[i] ? -1 : 1;
  }
  if (!x.pre.length || !y.pre.length) {
    if (!x.pre.length && !y.pre.length) return 0;
    return x.pre.length ? -1 : 1; // 预发布 < 正式版
  }
  const n = Math.max(x.pre.length, y.pre.length);
  for (let i = 0; i < n; i++) {
    const p = x.pre[i];
    const q = y.pre[i];
    if (p === undefined) return -1;
    if (q === undefined) return 1;
    const pn = /^\d+$/.test(p);
    const qn = /^\d+$/.test(q);
    if (pn && qn) {
      if (Number(p) !== Number(q)) return Number(p) < Number(q) ? -1 : 1;
    } else if (pn !== qn) {
      return pn ? -1 : 1; // 数字标识符 < 字母标识符
    } else if (p !== q) {
      return p < q ? -1 : 1;
    }
  }
  return 0;
}

function isPre(v) {
  const p = parseVer(v);
  return !!p && p.pre.length > 0;
}

// registry 上的最新版本（通道感知：读 dist-tags + 版本列表，不再只看 latest 单个 tag）
async function getRemoteInfo() {
  let doc = null;
  try {
    const r = await sh(
      'npm_config_registry=' + shq(NPM_REGISTRY) + ' ' + NPM + ' view ' + NPM_PKG + ' dist-tags versions --json 2>/dev/null',
      NPM_TIMEOUT
    );
    doc = JSON.parse(trim(r.stdout) || 'null');
  } catch (e) {
    doc = null;
  }
  const tags = (doc && doc['dist-tags']) || {};
  const versions = Array.isArray(doc && doc.versions) ? doc.versions.slice() : [];
  if (!versions.length) {
    // 兜底：老命令（只取 latest tag 指向的版本），并标注未能读取通道
    const r = await sh(
      'npm_config_registry=' + shq(NPM_REGISTRY) + ' ' + NPM + ' view ' + NPM_PKG + ' version 2>/dev/null',
      NPM_TIMEOUT
    );
    const version = trim(r.stdout).split('\n').pop() || null;
    return {
      packageVersion: version,
      latestTag: 'latest',
      channel: 'latest',
      channels: {},
      newest: version,
      hasStable: false,
      prerelease: isPre(version),
      channelsUnavailable: true,
    };
  }
  const hasStable = versions.some((v) => !isPre(v));
  const newest = versions.sort((a, b) => cmpVer(b, a))[0];
  let channel = UPDATE_CHANNEL;
  let version = null;
  if (channel !== 'auto') {
    version = channel === 'newest' ? newest : tags[channel] || null;
  } else if (hasStable) {
    channel = 'latest'; // 有正式版：跟随 latest 通道
    version = tags.latest || null;
  } else {
    channel = 'newest'; // 尚无正式版：取最高版本（可能为预发布）
    version = newest;
  }
  return {
    packageVersion: version,
    latestTag: channel,
    channel: channel,
    channels: tags,
    newest: newest,
    hasStable: hasStable,
    prerelease: isPre(version),
    channelMissing: !version,
  };
}

async function getUpdateInfo(doFetch) {
  // doFetch 兼容保留：npm view 本身总是实时查 registry
  const current = await getLocalInfo();
  const latest = await getRemoteInfo();
  const cur = current.packageVersion;
  const lat = latest.packageVersion;
  // 只在确有更高版本时报更新（旧逻辑用字符串不等，会把降级也误报成更新）
  const hasUpdate = !!cur && !!lat && cmpVer(cur, lat) < 0;
  const prerelease = !!latest.prerelease;
  return {
    ok: true,
    current: current,
    latest: latest,
    channels: latest.channels || {},
    newest: latest.newest || null,
    hasStable: !!latest.hasStable,
    prerelease: prerelease,
    // 预发布目标不能走自动更新：安装链路是 latest tag + 裸 spec 启动
    autoUpdateSupported: !prerelease,
    // 目标为预发布时，需要显式开关（POST /update?allowPrerelease=1）才会安装
    requiresOptIn: prerelease,
    pinned: readPin(),
    startCommand: await dshStartCommand(),
    hasUpdate: hasUpdate,
    compareUrl: 'https://www.npmjs.com/package/' + NPM_PKG + '?activeTab=versions',
  };
}

function setUpdate(partial) {
  updateState = Object.assign({}, updateState, partial);
  log('update: ' + JSON.stringify(partial));
}

function setLifecycle(partial) {
  lifecycle = Object.assign({}, lifecycle, partial);
  log('lifecycle: ' + JSON.stringify(partial));
}

async function readLogTail(file, lines) {
  try {
    const s = await fs.promises.readFile(file, 'utf8');
    const arr = s.split('\n');
    return arr.slice(-(lines || 100)).join('\n');
  } catch (e) { return ''; }
}

function appendDetail(line) {
  if (updateState.detail.length >= 300) updateState.detail.shift();
  updateState.detail.push(line);
}

async function currentPid() {
  const r = await sh(LSOF + ' -ti tcp:' + DSH_PORT + ' -sTCP:LISTEN 2>/dev/null | head -1');
  return r.stdout.trim();
}

// 先 SIGTERM 优雅退出，3 秒没退就 SIGKILL 强杀。
async function killPid(pid) {
  log('kill SIGTERM ' + pid);
  await sh('kill ' + pid + ' 2>/dev/null || true');
  await sh('for ((i=0;i<3;i++)); do ps -p ' + pid + ' >/dev/null 2>&1 || break; sleep 1; done');
  const alive = await sh('ps -p ' + pid + ' >/dev/null 2>&1 && echo yes || echo no');
  if (alive.stdout.trim() === 'yes') {
    log('still alive, SIGKILL ' + pid);
    await sh('kill -9 ' + pid + ' 2>/dev/null || true');
    await sh('sleep 1');
  }
}

async function waitFree(secs) {
  await sh('for ((i=0;i<' + secs + ';i++)); do ' + LSOF + ' -ti tcp:' + DSH_PORT + ' -sTCP:LISTEN >/dev/null 2>&1 || break; sleep 1; done');
}

// ---- Hindsight 本地 daemon 保活：启动 DSH 前检查 9077，没有则后台拉起并常驻 ----
function ensureHindsight() {
  const HEALTH = 'http://127.0.0.1:9077/health';
  const EMBED = process.env.DSH_HINDSIGHT_EMBED || path.join(os.homedir(), '.cargo', 'bin', 'hindsight-embed');
  sh('curl -s -o /dev/null -w "%{http_code}" --max-time 3 ' + HEALTH + ' 2>/dev/null || echo 000')
    .then((r) => {
      if (/^2/.test(String(r.stdout).trim())) return;
      log('hindsight daemon not healthy, starting...');
      const env = [
        'UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/',
        'UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/',
        'HF_ENDPOINT=https://hf-mirror.com',
        'HINDSIGHT_EMBED_DAEMON_STARTUP_TIMEOUT=900',
        'HINDSIGHT_EMBED_DAEMON_IDLE_TIMEOUT=0',
        'HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=1',
        'HINDSIGHT_API_RERANKER_LOCAL_FORCE_CPU=1',
      ].join(' ');
      sh('nohup env ' + env + ' ' + shq(EMBED) + ' -p coding-agent daemon start > /tmp/hindsight-daemon-start.log 2>&1 < /dev/null &');
    });
}

async function startDsh() {
  log('startDsh');
  ensureHindsight(); // Hindsight 本地 daemon：无则后台拉起，常驻
  // dsh 引擎要求 node ^22.19 || >=24;全局 node 被切回旧版(如 n 20.x)时,这里直接报错,
  // 而不是拉起一个注定在插件树阶段崩溃的 boot。
  const mv = /^v(\d+)\.(\d+)\./.exec(process.version);
  const major = mv ? Number(mv[1]) : 0;
  const minor = mv ? Number(mv[2]) : 0;
  const nodeOk = (major === 22 && minor >= 19) || major >= 24;
  if (!nodeOk) {
    const msg = '当前 node ' + process.version + ' 不满足 dsh 引擎要求 (^22.19 || >=24)，请切换 node（如 n 24.19.0）后重启 daemon';
    setLifecycle({ state: 'failed', startedAt: new Date().toISOString(), finishedAt: new Date().toISOString(), step: '启动失败', message: msg, error: msg, log: '' });
    log('start failed (node version)');
    return null;
  }
  setLifecycle({ state: 'starting', startedAt: new Date().toISOString(), finishedAt: null, step: '启动进程', message: '正在启动 DSH 进程', error: null, log: '' });
  await sh('nohup ' + (await dshStartCommand()) + ' > ' + DSH_LOG + ' 2>&1 < /dev/null &');
  setLifecycle({ state: 'starting', step: '等待端口', message: '正在等待端口 ' + DSH_PORT + ' 就绪' });
  await sh('for ((i=0;i<150;i++)); do ' + LSOF + ' -ti tcp:' + DSH_PORT + ' -sTCP:LISTEN >/dev/null 2>&1 && break; sleep 0.2; done');
  const pid = await currentPid();
  if (!pid) {
    const logTail = await readLogTail(DSH_LOG, 100);
    setLifecycle({ state: 'failed', step: '启动失败', message: 'DSH 启动失败', error: '端口 ' + DSH_PORT + ' 未在 15 秒内就绪', log: logTail, finishedAt: new Date().toISOString() });
    log('start failed (no listener)');
    return null;
  }
  // 端口就绪 ≠ boot 完成:插件树/client-modules 组合在 bind 之后仍可能崩溃。
  // 做健康检查:进程存活 + HTTP 响应 2xx/3xx(401 = token 门禁下的已就绪服务,同样视为健康;最多再等 20 秒)。
  setLifecycle({ state: 'starting', step: '健康检查', message: '端口已监听，正在等待 Web 服务就绪 (PID ' + pid + ')' });
  let healthy = false;
  for (let i = 0; i < 20; i++) {
    const aliveR = await sh('ps -p ' + pid + ' >/dev/null 2>&1 && echo yes || echo no');
    if (aliveR.stdout.trim() !== 'yes') break;
    const httpR = await sh('curl -s -o /dev/null -w "%{http_code}" --max-time 3 http://127.0.0.1:' + DSH_PORT + '/ 2>/dev/null || echo 000');
    const code = String(httpR.stdout).trim();
    if (/^(?:[23][0-9][0-9]|401)$/.test(code)) { healthy = true; break; }
    await sh('sleep 1');
  }
  if (healthy) {
    setLifecycle({ state: 'running', step: '已启动', message: 'DSH 已启动 (PID ' + pid + ')，健康检查通过', error: null, finishedAt: new Date().toISOString() });
  } else {
    const logTail = await readLogTail(DSH_LOG, 100);
    const msg = 'DSH 启动后未通过健康检查（进程崩溃或 Web 服务未就绪）';
    setLifecycle({ state: 'failed', step: '启动失败', message: msg, error: msg, log: logTail, finishedAt: new Date().toISOString() });
    log('start failed (health check)');
    return null;
  }
  log('started pid=' + pid);
  return pid;
}

async function ctlStatus() {
  const pid = await currentPid();
  return { ok: true, running: !!pid, pid: pid || null };
}
async function ctlStart() {
  const pid = await currentPid();
  if (pid) {
    setLifecycle({ state: 'running', step: '已在运行', message: 'DSH 已在运行 (PID ' + pid + ')', error: null, finishedAt: new Date().toISOString() });
    return { ok: true, running: true, pid: pid, status: 'already-running' };
  }
  const np = await startDsh();
  if (np) return { ok: true, running: true, pid: np, status: 'started' };
  const logTail = await readLogTail(DSH_LOG, 100);
  const errMsg = lifecycle.error || 'DSH 启动失败：端口 ' + DSH_PORT + ' 未在限定时间内就绪';
  setLifecycle({ state: 'failed', step: '启动失败', error: errMsg, message: errMsg, log: logTail, finishedAt: new Date().toISOString() });
  return { ok: false, error: errMsg, log: logTail };
}
async function ctlStop() {
  const pid = await currentPid();
  if (!pid) {
    setLifecycle({ state: 'idle', step: '未运行', message: 'DSH 未在运行', error: null, finishedAt: new Date().toISOString() });
    return { ok: true, running: false, status: 'not-running' };
  }
  setLifecycle({ state: 'stopping', startedAt: new Date().toISOString(), finishedAt: null, step: '停止中', message: '正在停止 DSH (PID ' + pid + ')', error: null });
  await killPid(pid);
  setLifecycle({ state: 'idle', step: '已停止', message: 'DSH 已停止', error: null, finishedAt: new Date().toISOString() });
  return { ok: true, running: false, status: 'stopped', pid: pid };
}
async function ctlRestart() {
  const pid = await currentPid();
  setLifecycle({ state: 'restarting', startedAt: new Date().toISOString(), finishedAt: null, step: '停止旧进程', message: pid ? '正在停止旧进程 (PID ' + pid + ')' : 'DSH 未运行，直接启动', error: null, log: '' });
  if (pid) { await killPid(pid); await waitFree(5); }
  const np = await startDsh();
  if (np) return { ok: true, running: true, pid: np, status: 'restarted', oldPid: pid || null };
  const logTail = await readLogTail(DSH_LOG, 100);
  const errMsg = lifecycle.error || 'DSH 重启失败：端口 ' + DSH_PORT + ' 未在限定时间内就绪';
  setLifecycle({ state: 'failed', step: '重启失败', error: errMsg, message: errMsg, log: logTail, finishedAt: new Date().toISOString() });
  return { ok: false, error: errMsg, log: logTail };
}

// ---- 更新流程：拉取 + 保留本地修改 + 重装/重建 ----
// force=true:跳过版本检查,即使已是最新也重装依赖+重建+重启(修复半损坏的安装)。
function pickPkgManager() {
  // npx 模式不再需要 pnpm install + build;保留签名仅为兼容
  return { install: '', build: '' };
}

// ---- 更新流程（npx 模式）：清除缓存 → 预热拉取最新 → 重启 ----
// 预发布目标（alpha/next 或尚无正式版时的最高版本）默认拒绝，需 opts.allowPrerelease
// （POST /update?allowPrerelease=1）；该分支改为在既有 _npx 目录内原地安装，避免版本错配。
// force=true:跳过版本检查,即使已是最新也重新拉取+重启(修复半损坏的安装)。
async function runUpdate(force, opts) {
  force = force === true;
  const allowPre = !!(opts && opts.allowPrerelease);
  setUpdate({ state: 'running', startedAt: new Date().toISOString(), finishedAt: null, step: force ? '准备修复/重装' : '准备检查版本', message: '', error: null, warnings: [], detail: [] });
  try {
    const info = await getUpdateInfo(true);
    if (!info.ok) throw new Error('无法获取更新信息');
    if (!info.hasUpdate && !force) {
      setUpdate({ state: 'completed', step: '已是最新', message: '当前已是最新版本，无需更新', finishedAt: new Date().toISOString() });
      return;
    }
    // 预发布目标（alpha/next 通道，或尚无正式版时 registry 上的最高版本）默认不安装，需显式开关：
    // 勾选「允许预发布版」(POST /update?allowPrerelease=1) 才走原地安装。
    if (info.hasUpdate && info.prerelease && !allowPre && !force) {
      throw new Error(
        'registry 上更高的版本 ' + info.latest.packageVersion + ' 属预发布通道（' + info.latest.latestTag + '），默认不自动安装预发布版。' +
        '如需安装，请在扩展弹窗勾选「允许预发布版」后重试（等价于 POST /update?allowPrerelease=1），或等待正式版发布。' +
        '若已勾选仍报此错，说明扩展后台仍是旧脚本（未在 chrome://extensions 重新加载），可对照守护进程日志的 update request 行确认本次请求是否带开关。'
      );
    }
    const doUpdate = info.hasUpdate;
    const preInstall = doUpdate && info.prerelease && allowPre;
    // 原地安装要在清缓存之前先记下 _npx 目录：清缓存会删掉 findNpxDshDir() 的探测依据
    let inPlaceDirHint = null;
    if (preInstall) {
      const pkgDir = findNpxDshDir();
      inPlaceDirHint = pkgDir ? path.dirname(path.dirname(pkgDir)) : null;
      if (!inPlaceDirHint) throw new Error('未找到 npx 缓存中的 ' + NPM_PKG + ' 安装目录，无法原地安装预发布版');
    }

    const wasRunning = !!(await currentPid());
    if (wasRunning) {
      setUpdate({ step: '停止当前 DSH 服务', message: '正在停止 DSH 以便安全更新' });
      await ctlStop();
      await waitFree(5);
    }

    // 清除 npx 缓存里该包的所有副本,强制下次 npx 重新拉取
    setUpdate({ step: '清除 npx 缓存', message: '正在清除 ' + NPM_PKG + ' 的 npx 缓存' });
    const cacheBase = npxCacheBase();
    let cleared = 0;
    try {
      for (const entry of fs.readdirSync(cacheBase)) {
        const pkgDir = path.join(cacheBase, entry, 'node_modules', NPM_PKG);
        if (fs.existsSync(pkgDir)) {
          fs.rmSync(pkgDir, { recursive: true, force: true });
          cleared++;
          appendDetail('cleared: ' + pkgDir);
        }
      }
    } catch (e) {
      updateState.warnings.push('清除 npx 缓存失败（可手动删除 ~/.npm/_npx 下 ' + NPM_PKG + ' 目录）：' + String((e && e.message) || e));
    }
    appendDetail('npx cache cleared: ' + cleared + ' copy(ies)');

    let installedVersion = null;
    if (preInstall) {
      // 预发布版:在既有 _npx 目录内原地安装指定版本,保持 host 与插件树同源(不新建第二个 _npx 目录)
      setUpdate({ step: '安装预发布版', message: '正在原地安装 ' + NPM_PKG + '@' + info.latest.packageVersion });
      const inPlaceDir = await installVersionInPlace(info.latest.packageVersion, inPlaceDirHint);
      installedVersion = info.latest.packageVersion;
      appendDetail('in-place install: ' + NPM_PKG + '@' + installedVersion + ' @ ' + inPlaceDir);
      writePin(installedVersion); // 钉住：npx 裸 spec 会回查 latest 把它打回去，启动改走直启副本
    } else {
      // 常规通道：撤掉预发布钉住，回到裸 spec 启动（/repair 也走这里 = 回到 latest 通道）
      clearPin();
      // 预热:强制解析 registry 最新版并下载(验证包可拉取)
      setUpdate({ step: '拉取最新版本', message: '正在从 npm registry 拉取 ' + NPM_PKG + (doUpdate ? ' 最新版 ' + info.latest.packageVersion : '') });
      const warm = await sh(
        'npm_config_registry=' + shq(NPM_REGISTRY) + ' ' + NPX + ' -y ' + NPM_PKG + ' --version 2>&1',
        NPM_TIMEOUT
      );
      if (warm.code !== 0) throw new Error('拉取 ' + NPM_PKG + ' 失败：' + tail(warm.stderr || warm.stdout, 2000));
    }

    if (wasRunning || force) {
      setUpdate({ step: '重新启动 DSH', message: '正在重新启动 DSH 服务' });
      await ctlStart();
    }

    setUpdate({
      state: 'completed',
      step: '完成',
      message: doUpdate
        ? (preInstall
          ? 'DSH 已安装预发布版 ' + installedVersion + '（原地安装，未新建 npx 目录）'
          : 'DSH 已更新到 ' + info.latest.packageVersion + '（npx 缓存已刷新）')
        : 'DSH 已重装并重启',
      finishedAt: new Date().toISOString(),
    });
  } catch (e) {
    setUpdate({
      state: 'failed',
      step: '失败',
      error: String((e && e.message) || e),
      message: '更新失败，本地配置未被覆盖',
      finishedAt: new Date().toISOString(),
    });
  } finally {
    updating = false;
  }
}

const server = http.createServer(async function (req, res) {
  // ---- 生命周期控制端点 ----
  if (req.method === 'GET' && req.url === '/status') {
    ctlStatus().then((r) => respond(res, r), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }
  if (req.method === 'POST' && req.url === '/start') {
    ctlStart().then((r) => respond(res, r), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }
  if (req.method === 'POST' && req.url === '/stop') {
    ctlStop().then((r) => respond(res, r), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }
  if (req.method === 'POST' && req.url === '/restart') {
    ctlRestart().then((r) => respond(res, r), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }

  // ---- 版本检查 / 更新端点 ----
  if (req.method === 'GET' && req.url === '/version') {
    getLocalInfo().then((r) => respond(res, { ok: true, ...r }), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }
  if (req.method === 'GET' && req.url === '/update-check') {
    getUpdateInfo(true).then((r) => respond(res, r), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }
  if (req.method === 'GET' && req.url === '/update-status') {
    respond(res, { ok: true, updating: updating, ...updateState });
    return;
  }
  if (req.method === 'POST' && (req.url === '/update' || req.url.startsWith('/update?') || req.url === '/repair' || req.url.startsWith('/repair?'))) {
    if (updating) { respond(res, { ok: false, error: '已有更新任务正在执行', state: updateState.state }); return; }
    const u = new URL(req.url, 'http://localhost');
    const force = req.url.startsWith('/repair') || u.searchParams.get('force') === '1' || u.searchParams.get('force') === 'true';
    const allowPrerelease = u.searchParams.get('allowPrerelease') === '1' || u.searchParams.get('allowPrerelease') === 'true';
    updating = true;
    log('update request: ' + req.url + ' (force=' + force + ', allowPrerelease=' + allowPrerelease + ')');
    runUpdate(force, { allowPrerelease: allowPrerelease });
    respond(res, { ok: true, started: true, state: 'running', force: force, allowPrerelease: allowPrerelease });
    return;
  }

  // ---- 服务生命周期 / 日志端点 ----
  if (req.method === 'GET' && req.url === '/lifecycle') {
    const pid = await currentPid();
    respond(res, { ok: true, running: !!pid, pid: pid || null, ...lifecycle });
    return;
  }
  if (req.method === 'GET' && req.url.startsWith('/logs')) {
    const u = new URL(req.url, 'http://localhost');
    const name = u.searchParams.get('name') === 'daemon' ? 'daemon' : 'dsh';
    const lines = Math.min(parseInt(u.searchParams.get('lines') || '300', 10) || 300, 2000);
    const file = name === 'daemon' ? CTL_LOG : DSH_LOG;
    fs.readFile(file, 'utf8', (err, data) => {
      if (err) { respond(res, { ok: false, error: '无法读取日志 ' + file + '：' + err.message }, 500); return; }
      const arr = data.split('\n');
      respond(res, { ok: true, name: name, file: file, lines: lines, log: arr.slice(-lines).join('\n') });
    });
    return;
  }

  if (req.method === 'OPTIONS') { respond(res, { ok: true }); return; }

  // ---- 转发端点 ----
  if (req.method === 'GET' && req.url === '/pending') {
    while (pending.length > 0 && Date.now() - pending[0].at > 30000) pending.shift();
    if (pending.length > 0) { respond(res, pending.shift()); return; }
    const w = { res: res, timer: null };
    w.timer = setTimeout(function () {
      const i = waiters.indexOf(w);
      if (i >= 0) waiters.splice(i, 1);
      respond(res, { id: null });
    }, 25000);
    waiters.push(w);
    return;
  }
  if (req.method === 'POST' && req.url === '/result') {
    let data = '';
    req.on('data', function (c) { data += c; });
    req.on('end', function () {
      let msg = {};
      try { msg = JSON.parse(data); } catch (e) {}
      const entry = results.get(msg.id);
      if (entry) { clearTimeout(entry.timer); results.delete(msg.id); entry.resolve(msg); }
      respond(res, { ok: true });
    });
    return;
  }
  if (req.method === 'POST' && req.url === '/forward') {
    let data = '';
    req.on('data', function (c) { data += c; });
    req.on('end', function () {
      let fwd = {};
      try { fwd = JSON.parse(data); } catch (e) {}
      if (!fwd || !fwd.url) { respond(res, { error: 'missing url' }, 400); return; }
      const id = 'f' + (++seq) + '-' + Date.now();
      const method = String(fwd.method || 'GET').toUpperCase();
      const req2 = {
        id: id,
        url: fwd.url,
        method: method,
        headers: fwd.headers || {},
        body: fwd.body || null,
        mode: fwd.mode || 'auto',
        wait_for_selector: fwd.wait_for_selector || '',
        target_selector: fwd.target_selector || '',
        timeout: Math.min(Math.max(Number(fwd.timeout) || 30, 5), 120),
        scroll: Math.min(Math.max(Number(fwd.scroll) || 0, 0), 20),
        format: fwd.format || 'markdown',
        at: Date.now(),
      };
      const timeoutSec = Math.min((Number(fwd.timeout) || 30) + 10, 150);
      const timer = setTimeout(function () {
        results.delete(id);
        respond(res, { error: '转发超时：浏览器扩展未连接或未响应（' + timeoutSec + 's）' });
      }, timeoutSec * 1000);
      results.set(id, {
        timer: timer,
        resolve: function (msg) {
          clearTimeout(timer);
          results.delete(id);
          respond(res, { status: msg.status, statusText: msg.statusText, headers: msg.headers, body: msg.body, ...(msg.extra && typeof msg.extra === 'object' ? msg.extra : {}) });
        },
      });
      if (waiters.length > 0) { const w = waiters.shift(); clearTimeout(w.timer); respond(w.res, req2); }
      else { pending.push(req2); }
    });
    return;
  }

  respond(res, { error: 'not found' }, 404);
});

server.listen(PORT, '127.0.0.1', function () {
  console.log('dsh-relay-daemon on 127.0.0.1:' + PORT);
  log('daemon started node=' + process.version + ' execPath=' + NODE);
});
