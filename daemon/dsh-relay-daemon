#!/usr/bin/env node
'use strict';
const http = require('http');
const { execFile } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');

const PORT = Number(process.env.DSH_DAEMON_PORT || 9317);
// 本机 DSH checkout 路径。也可用环境变量 DSH_CHECKOUT 覆盖。
const DSH_DIR = process.env.DSH_CHECKOUT || path.join(os.homedir(), 'deepseek-harness');
const DSH_PORT = Number(process.env.DSH_PORT || 3080);
const DSH_LOG = '/tmp/dsh-web-' + DSH_PORT + '.log';
const CTL_LOG = '/tmp/dsh-relay-daemon.log';
const LSOF = '/usr/sbin/lsof';
const NODE = process.execPath;
// DSH 启动命令。默认用编译产物（生产模式）；开发模式可整条覆盖，例如：
//   DSH_START_CMD="node --import tsx/esm apps/cli/src/bin.ts web --port 3080"
const DSH_START = process.env.DSH_START_CMD || (NODE + ' apps/cli/lib/bin.js web --port ' + DSH_PORT);

// ---- 版本检查 / 更新 ----
const REMOTE = process.env.DSH_REMOTE || 'origin';
const UPDATE_REPO_URL = process.env.DSH_REPO_URL || 'https://github.com/deepseek-ai/deepseek-harness';
const PACKAGE_REL = 'apps/cli/package.json';
const FETCH_TIMEOUT = 2 * 60 * 1000;
const BUILD_TIMEOUT = 10 * 60 * 1000;

// ---- 转发状态 ----
let seq = 0;
const pending = [];
const waiters = [];
const results = new Map();

// ---- 更新任务状态 ----
let updating = false;
let updateState = { state: 'idle', startedAt: null, finishedAt: null, step: '', message: '', error: null, warnings: [], detail: [] };

// ---- 服务生命周期状态（启动/停止/重启进度） ----
let lifecycle = {
  state: 'idle',        // idle | starting | running | stopping | restarting | failed
  startedAt: null,
  finishedAt: null,
  step: '',
  message: '',
  error: null,
  log: '',
};

function log(msg) {
  try { fs.appendFileSync(CTL_LOG, new Date().toISOString() + ' ' + msg + '\n'); } catch (e) {}
}

function respond(res, obj, status) {
  const body = JSON.stringify(obj);
  res.writeHead(status || 200, {
    'Content-Type': 'application/json; charset=utf-8',
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET,POST,OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
  });
  res.end(body);
}

function sh(cmd, timeout) {
  return new Promise((resolve) => {
    execFile('/bin/bash', ['-c', cmd], { timeout: timeout || 30000, maxBuffer: 16 * 1024 * 1024 }, (err, stdout, stderr) => {
      resolve({ code: err ? (typeof err.code === 'number' ? err.code : 1) : 0, stdout: String(stdout), stderr: String(stderr) });
    });
  });
}

// shell 单引号转义
function shq(s) {
  return "'" + String(s).replace(/'/g, "'\\''") + "'";
}

function trim(s) {
  return String(s || '').trim();
}

function tail(s, n) {
  const t = trim(s);
  if (!t) return '';
  return t.length > (n || 4000) ? t.slice(-(n || 4000)) : t;
}

function git(args, timeout) {
  return sh('git -C ' + shq(DSH_DIR) + ' ' + args, timeout);
}

function readJson(file) {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch (e) { return null; }
}

async function getLocalInfo() {
  const [headR, fullR, branchR, diffR, cachedR] = await Promise.all([
    git('rev-parse --short HEAD 2>/dev/null'),
    git('rev-parse HEAD 2>/dev/null'),
    git('symbolic-ref --short HEAD 2>/dev/null'),
    git('diff --quiet 2>/dev/null'),
    git('diff --cached --quiet 2>/dev/null'),
  ]);
  const info = {
    dir: DSH_DIR,
    commit: trim(fullR.stdout) || null,
    shortCommit: trim(headR.stdout) || null,
    branch: trim(branchR.stdout) || 'master',
    dirty: diffR.code !== 0 || cachedR.code !== 0,
  };
  const pkg = readJson(path.join(DSH_DIR, PACKAGE_REL));
  info.packageVersion = (pkg && pkg.version) || null;
  return info;
}

async function getRemoteInfo(branch) {
  const [shortR, fullR, fileR] = await Promise.all([
    git('rev-parse --short ' + REMOTE + '/' + branch + ' 2>/dev/null'),
    git('rev-parse ' + REMOTE + '/' + branch + ' 2>/dev/null'),
    git('show ' + REMOTE + '/' + branch + ':' + PACKAGE_REL + ' 2>/dev/null'),
  ]);
  let pkg = null;
  try { pkg = JSON.parse(fileR.stdout); } catch (e) {}
  return {
    commit: trim(fullR.stdout) || null,
    shortCommit: trim(shortR.stdout) || null,
    packageVersion: (pkg && pkg.version) || null,
  };
}

async function getUpdateInfo(doFetch) {
  if (doFetch) {
    const f = await git('fetch ' + REMOTE + ' --prune 2>&1', FETCH_TIMEOUT);
    if (f.code !== 0) throw new Error('git fetch 失败：' + tail(f.stderr || f.stdout, 2000));
  }
  const current = await getLocalInfo();
  const branch = current.branch || 'master';
  const latest = await getRemoteInfo(branch);
  const behindR = await git('rev-list --count HEAD..' + REMOTE + '/' + branch + ' 2>/dev/null');
  const aheadR = await git('rev-list --count ' + REMOTE + '/' + branch + '..HEAD 2>/dev/null');
  const behind = parseInt(trim(behindR.stdout), 10) || 0;
  const ahead = parseInt(trim(aheadR.stdout), 10) || 0;
  return {
    ok: true,
    branch: branch,
    current: current,
    latest: latest,
    hasUpdate: behind > 0,
    behind: behind,
    ahead: ahead,
    compareUrl: UPDATE_REPO_URL + '/compare/' + encodeURIComponent(current.commit || 'HEAD') + '...' + encodeURIComponent(latest.commit || (REMOTE + '/' + branch)),
  };
}

function setUpdate(partial) {
  updateState = Object.assign({}, updateState, partial);
  log('update: ' + JSON.stringify(partial));
}

function setLifecycle(partial) {
  lifecycle = Object.assign({}, lifecycle, partial);
  log('lifecycle: ' + JSON.stringify(partial));
}

async function readLogTail(file, lines) {
  try {
    const s = await fs.promises.readFile(file, 'utf8');
    const arr = s.split('\n');
    return arr.slice(-(lines || 100)).join('\n');
  } catch (e) { return ''; }
}

function appendDetail(line) {
  if (updateState.detail.length >= 300) updateState.detail.shift();
  updateState.detail.push(line);
}

function pickPkgManager() {
  const binDir = path.dirname(NODE);
  const pnpm = path.join(binDir, 'pnpm');
  const npm = path.join(binDir, 'npm');
  if (fs.existsSync(pnpm)) return { install: pnpm + ' install', build: pnpm + ' run build' };
  return { install: npm + ' install', build: npm + ' run build' };
}

async function currentPid() {
  const r = await sh(LSOF + ' -ti tcp:' + DSH_PORT + ' -sTCP:LISTEN 2>/dev/null | head -1');
  return r.stdout.trim();
}

// 先 SIGTERM 优雅退出，3 秒没退就 SIGKILL 强杀。
async function killPid(pid) {
  log('kill SIGTERM ' + pid);
  await sh('kill ' + pid + ' 2>/dev/null || true');
  await sh('for ((i=0;i<3;i++)); do ps -p ' + pid + ' >/dev/null 2>&1 || break; sleep 1; done');
  const alive = await sh('ps -p ' + pid + ' >/dev/null 2>&1 && echo yes || echo no');
  if (alive.stdout.trim() === 'yes') {
    log('still alive, SIGKILL ' + pid);
    await sh('kill -9 ' + pid + ' 2>/dev/null || true');
    await sh('sleep 1');
  }
}

async function waitFree(secs) {
  await sh('for ((i=0;i<' + secs + ';i++)); do ' + LSOF + ' -ti tcp:' + DSH_PORT + ' -sTCP:LISTEN >/dev/null 2>&1 || break; sleep 1; done');
}

async function startDsh() {
  log('startDsh');
  setLifecycle({ state: 'starting', startedAt: new Date().toISOString(), finishedAt: null, step: '启动进程', message: '正在启动 DSH 进程', error: null, log: '' });
  await sh('cd ' + shq(DSH_DIR) + '; nohup ' + DSH_START + ' > ' + DSH_LOG + ' 2>&1 < /dev/null &');
  setLifecycle({ state: 'starting', step: '等待端口', message: '正在等待端口 ' + DSH_PORT + ' 就绪' });
  await sh('for ((i=0;i<75;i++)); do ' + LSOF + ' -ti tcp:' + DSH_PORT + ' -sTCP:LISTEN >/dev/null 2>&1 && break; sleep 0.2; done');
  const pid = await currentPid();
  if (pid) {
    setLifecycle({ state: 'running', step: '已启动', message: 'DSH 已启动 (PID ' + pid + ')', error: null, finishedAt: new Date().toISOString() });
  } else {
    setLifecycle({ state: 'failed', step: '启动失败', message: 'DSH 启动失败', error: '端口 ' + DSH_PORT + ' 未在 15 秒内就绪', finishedAt: new Date().toISOString() });
  }
  log('started pid=' + pid);
  return pid;
}

async function ctlStatus() {
  const pid = await currentPid();
  return { ok: true, running: !!pid, pid: pid || null };
}
async function ctlStart() {
  const pid = await currentPid();
  if (pid) {
    setLifecycle({ state: 'running', step: '已在运行', message: 'DSH 已在运行 (PID ' + pid + ')', error: null, finishedAt: new Date().toISOString() });
    return { ok: true, running: true, pid: pid, status: 'already-running' };
  }
  const np = await startDsh();
  if (np) return { ok: true, running: true, pid: np, status: 'started' };
  const logTail = await readLogTail(DSH_LOG, 100);
  const errMsg = lifecycle.error || 'DSH 启动失败：端口 ' + DSH_PORT + ' 未在限定时间内就绪';
  setLifecycle({ state: 'failed', step: '启动失败', error: errMsg, message: errMsg, log: logTail, finishedAt: new Date().toISOString() });
  return { ok: false, error: errMsg, log: logTail };
}
async function ctlStop() {
  const pid = await currentPid();
  if (!pid) {
    setLifecycle({ state: 'idle', step: '未运行', message: 'DSH 未在运行', error: null, finishedAt: new Date().toISOString() });
    return { ok: true, running: false, status: 'not-running' };
  }
  setLifecycle({ state: 'stopping', startedAt: new Date().toISOString(), finishedAt: null, step: '停止中', message: '正在停止 DSH (PID ' + pid + ')', error: null });
  await killPid(pid);
  setLifecycle({ state: 'idle', step: '已停止', message: 'DSH 已停止', error: null, finishedAt: new Date().toISOString() });
  return { ok: true, running: false, status: 'stopped', pid: pid };
}
async function ctlRestart() {
  const pid = await currentPid();
  setLifecycle({ state: 'restarting', startedAt: new Date().toISOString(), finishedAt: null, step: '停止旧进程', message: pid ? '正在停止旧进程 (PID ' + pid + ')' : 'DSH 未运行，直接启动', error: null, log: '' });
  if (pid) { await killPid(pid); await waitFree(5); }
  const np = await startDsh();
  if (np) return { ok: true, running: true, pid: np, status: 'restarted', oldPid: pid || null };
  const logTail = await readLogTail(DSH_LOG, 100);
  const errMsg = lifecycle.error || 'DSH 重启失败：端口 ' + DSH_PORT + ' 未在限定时间内就绪';
  setLifecycle({ state: 'failed', step: '重启失败', error: errMsg, message: errMsg, log: logTail, finishedAt: new Date().toISOString() });
  return { ok: false, error: errMsg, log: logTail };
}

// ---- 更新流程：拉取 + 保留本地修改 + 重装/重建 ----
async function runUpdate() {
  setUpdate({ state: 'running', startedAt: new Date().toISOString(), finishedAt: null, step: '准备检查仓库', message: '', error: null, warnings: [], detail: [] });
  try {
    const info = await getUpdateInfo(true);
    if (!info.ok) throw new Error('无法获取更新信息');
    if (!info.hasUpdate) {
      setUpdate({ state: 'completed', step: '已是最新', message: '当前已是最新版本，无需更新', finishedAt: new Date().toISOString() });
      return;
    }

    const wasRunning = !!(await currentPid());
    if (wasRunning) {
      setUpdate({ step: '停止当前 DSH 服务', message: '正在停止 DSH 以便安全更新' });
      await ctlStop();
      await waitFree(5);
    }

    // 只暂存“已跟踪文件”的本地修改；未跟踪的本地插件/构建产物原样保留。
    let stashed = false;
    const diffR = await git('diff --quiet 2>/dev/null');
    const cachedR = await git('diff --cached --quiet 2>/dev/null');
    if (diffR.code !== 0 || cachedR.code !== 0) {
      setUpdate({ step: '暂存本地修改', message: '更新前暂存本地已跟踪修改，完成后自动恢复' });
      const stashName = 'dsh-update-auto-' + Date.now();
      const sr = await git('stash push -m ' + shq(stashName) + ' --quiet', 60000);
      if (sr.code !== 0) throw new Error('暂存本地修改失败（未执行更新，原文件未动）：' + tail(sr.stderr || sr.stdout, 2000));
      stashed = true;
      appendDetail('stash: ' + stashName);
    }

    setUpdate({ step: '拉取远端更新', message: '正在从 ' + REMOTE + '/' + info.branch + ' 拉取' });
    const mr = await git('merge --ff-only ' + REMOTE + '/' + info.branch + ' 2>&1', FETCH_TIMEOUT);
    if (mr.code !== 0) {
      if (stashed) {
        setUpdate({ step: '拉取失败，恢复本地修改', message: '更新失败，正在恢复本地修改' });
        await git('stash pop 2>&1', 60000);
      }
      throw new Error('拉取更新失败（本地修改已保留）：' + tail(mr.stderr || mr.stdout, 2000));
    }
    appendDetail('merge ok');

    if (stashed) {
      setUpdate({ step: '恢复本地修改', message: '正在恢复更新前暂存的本地修改' });
      const pr = await git('stash pop 2>&1', 60000);
      if (pr.code !== 0) {
        updateState.warnings.push('拉取成功，但自动恢复本地修改时出现冲突，本地修改已保留在工作区，请手动处理：git stash list');
        appendDetail('stash pop warning: ' + tail(pr.stderr || pr.stdout, 2000));
        throw new Error('拉取完成，但恢复本地修改时出现冲突（本地修改已保留，未覆盖）；请手动解决冲突后重新构建。');
      }
    }

    const pkgm = pickPkgManager();
    setUpdate({ step: '安装依赖', message: '正在安装/更新 DSH 依赖' });
    const ir = await sh('cd ' + shq(DSH_DIR) + ' && ' + pkgm.install + ' 2>&1', BUILD_TIMEOUT);
    if (ir.code !== 0) throw new Error('依赖安装失败：' + tail(ir.stderr || ir.stdout, 3000));

    setUpdate({ step: '重新构建 DSH', message: '正在重新构建（可能需要几分钟）' });
    const br = await sh('cd ' + shq(DSH_DIR) + ' && ' + pkgm.build + ' 2>&1', BUILD_TIMEOUT);
    if (br.code !== 0) throw new Error('构建失败：' + tail(br.stderr || br.stdout, 3000));

    if (wasRunning) {
      setUpdate({ step: '重新启动 DSH', message: '正在重新启动 DSH 服务' });
      await ctlStart();
    }

    setUpdate({
      state: 'completed',
      step: '完成',
      message: 'DSH 已更新并重新构建，本地插件/设置已保留',
      finishedAt: new Date().toISOString(),
    });
  } catch (e) {
    setUpdate({
      state: 'failed',
      step: '失败',
      error: String((e && e.message) || e),
      message: '更新失败，本地文件未被覆盖',
      finishedAt: new Date().toISOString(),
    });
  } finally {
    updating = false;
  }
}

const server = http.createServer(async function (req, res) {
  // ---- 生命周期控制端点 ----
  if (req.method === 'GET' && req.url === '/status') {
    ctlStatus().then((r) => respond(res, r), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }
  if (req.method === 'POST' && req.url === '/start') {
    ctlStart().then((r) => respond(res, r), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }
  if (req.method === 'POST' && req.url === '/stop') {
    ctlStop().then((r) => respond(res, r), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }
  if (req.method === 'POST' && req.url === '/restart') {
    ctlRestart().then((r) => respond(res, r), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }

  // ---- 版本检查 / 更新端点 ----
  if (req.method === 'GET' && req.url === '/version') {
    getLocalInfo().then((r) => respond(res, { ok: true, ...r }), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }
  if (req.method === 'GET' && req.url === '/update-check') {
    getUpdateInfo(true).then((r) => respond(res, r), (e) => respond(res, { ok: false, error: String((e && e.message) || e) }, 500));
    return;
  }
  if (req.method === 'GET' && req.url === '/update-status') {
    respond(res, { ok: true, updating: updating, ...updateState });
    return;
  }
  if (req.method === 'POST' && req.url === '/update') {
    if (updating) { respond(res, { ok: false, error: '已有更新任务正在执行', state: updateState.state }); return; }
    updating = true;
    runUpdate();
    respond(res, { ok: true, started: true, state: 'running' });
    return;
  }

  // ---- 服务生命周期 / 日志端点 ----
  if (req.method === 'GET' && req.url === '/lifecycle') {
    const pid = await currentPid();
    respond(res, { ok: true, running: !!pid, pid: pid || null, ...lifecycle });
    return;
  }
  if (req.method === 'GET' && req.url.startsWith('/logs')) {
    const u = new URL(req.url, 'http://localhost');
    const name = u.searchParams.get('name') === 'daemon' ? 'daemon' : 'dsh';
    const lines = Math.min(parseInt(u.searchParams.get('lines') || '300', 10) || 300, 2000);
    const file = name === 'daemon' ? CTL_LOG : DSH_LOG;
    fs.readFile(file, 'utf8', (err, data) => {
      if (err) { respond(res, { ok: false, error: '无法读取日志 ' + file + '：' + err.message }, 500); return; }
      const arr = data.split('\n');
      respond(res, { ok: true, name: name, file: file, lines: lines, log: arr.slice(-lines).join('\n') });
    });
    return;
  }

  if (req.method === 'OPTIONS') { respond(res, { ok: true }); return; }

  // ---- 转发端点 ----
  if (req.method === 'GET' && req.url === '/pending') {
    while (pending.length > 0 && Date.now() - pending[0].at > 30000) pending.shift();
    if (pending.length > 0) { respond(res, pending.shift()); return; }
    const w = { res: res, timer: null };
    w.timer = setTimeout(function () {
      const i = waiters.indexOf(w);
      if (i >= 0) waiters.splice(i, 1);
      respond(res, { id: null });
    }, 25000);
    waiters.push(w);
    return;
  }
  if (req.method === 'POST' && req.url === '/result') {
    let data = '';
    req.on('data', function (c) { data += c; });
    req.on('end', function () {
      let msg = {};
      try { msg = JSON.parse(data); } catch (e) {}
      const entry = results.get(msg.id);
      if (entry) { clearTimeout(entry.timer); results.delete(msg.id); entry.resolve(msg); }
      respond(res, { ok: true });
    });
    return;
  }
  if (req.method === 'POST' && req.url === '/forward') {
    let data = '';
    req.on('data', function (c) { data += c; });
    req.on('end', function () {
      let fwd = {};
      try { fwd = JSON.parse(data); } catch (e) {}
      if (!fwd || !fwd.url) { respond(res, { error: 'missing url' }, 400); return; }
      const id = 'f' + (++seq) + '-' + Date.now();
      const req2 = { id: id, url: fwd.url, method: fwd.method || 'GET', headers: fwd.headers || {}, body: fwd.body || null, at: Date.now() };
      const timer = setTimeout(function () {
        results.delete(id);
        respond(res, { error: '转发超时：浏览器扩展未连接或未响应' });
      }, 30000);
      results.set(id, {
        timer: timer,
        resolve: function (msg) {
          clearTimeout(timer);
          results.delete(id);
          respond(res, { status: msg.status, statusText: msg.statusText, headers: msg.headers, body: msg.body });
        },
      });
      if (waiters.length > 0) { const w = waiters.shift(); clearTimeout(w.timer); respond(w.res, req2); }
      else { pending.push(req2); }
    });
    return;
  }

  respond(res, { error: 'not found' }, 404);
});

server.listen(PORT, '127.0.0.1', function () {
  console.log('dsh-relay-daemon on 127.0.0.1:' + PORT);
});
