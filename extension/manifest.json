{
  "manifest_version": 3,
  "name": "DSH 控制",
  "version": "1.5.0",
  "description": "DSH web 服务控制、请求转发与版本检查/一键更新；并静默捕获 Figma WS Kiwi 帧",
  "icons": { "128": "icon-running.png" },
  "key": "",
  "action": {
    "default_title": "DSH 控制",
    "default_icon": { "128": "icon-stopped.png" },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["alarms", "contextMenus", "notifications", "storage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "https://www.figma.com/design/*",
        "https://www.figma.com/file/*",
        "https://www.figma.com/proto/*"
      ],
      "js": ["figma-ws-content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["figma-ws-hook.js"],
      "matches": ["https://www.figma.com/*"]
    }
  ]
}
