{
  "manifest_version": 3,
  "name": "DSH 控制",
  "version": "1.2.0",
  "description": "DSH web 服务启动/重启/停止控制与请求转发",
  "key": "",
  "action": {
    "default_title": "DSH 控制"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["alarms", "contextMenus", "nativeMessaging"],
  "host_permissions": ["<all_urls>"]
}
