{
  "name": "@deepseek-ai/dsh-tool-browser",
  "description": "Model-facing browser tools for the already-logged-in Chrome. chrome_* tools drive Chrome through an in-process CDP hub (one persistent connection, so one authorization per Chrome session); legacy browser/verify_page still use browser-harness.",
  "version": "0.2.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/hub/**/*.js",
    "lib/types/**/*.d.ts",
    "resources/cdp-hub.mjs",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.5 || >=0.1.6-alpha.1 <0.2",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5 || >=0.1.6-alpha.1 <0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
